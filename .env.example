# AI Financial Analyst System — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=1.0
GOOGLE_CLOUD_PROJECT=

# ── RapidAPI TradingView ───────────────────────────────────────────────────────
RAPIDAPI_KEY=

# ── Tastytrade (Options Backtesting) ──────────────────────────────────────────
# Production API only. Do NOT use api.cert.tastyworks.com here.
TASTYTRADE_API_BASE_URL=https://api.tastyworks.com
TASTYTRADE_BACKTESTER_BASE_URL=https://backtester.vast.tastyworks.com
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ACCESS_TOKEN=
TASTYTRADE_USER_AGENT=ajay-ai-finance/1.0

# ── App ────────────────────────────────────────────────────────────────────────
CURRENT_USER=Ajay

# Discord signal transport
DISCORD_BOT_TOKEN=
DISCORD_SIGNAL_CHANNEL_ID=
AGENT_REVIEW_CHANNEL_ID=
DISCORD_PAPER_LOG_CHANNEL_ID=

# WhatsApp Cloud API transport (optional)
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_HOST=0.0.0.0
WHATSAPP_PORT=5000
WHATSAPP_ALLOWED_SENDER_IDS=
WHATSAPP_ALLOWED_GROUP_IDS=
# Separate, narrower allowlist for !agent_on / !agent_off / !agent_retry_dead
# from WhatsApp (mirrors the Discord Administrator/Manage Server gate, since
# WhatsApp has no guild-permission concept). Being in the allowlist above only
# grants signal access, not mode-changing control.
WHATSAPP_ADMIN_SENDER_IDS=
# Destination for proactive/background alerts (protection triggers, a queued
# order finally filling, a contract becoming tradable, ...) -- these fire from
# the periodic monitor loop, not in reply to an incoming message, so there's
# no WhatsApp target to infer the way a normal reply has one. This is the
# WhatsApp equivalent of AGENT_REVIEW_CHANNEL_ID / DISCORD_PAPER_LOG_CHANNEL_ID.
# Phone number for an individual, or the group ID for the signals group.
WHATSAPP_ALERT_TARGET=
WHATSAPP_ALERT_IS_GROUP=true

# Shared durable signal workers
SIGNAL_WORKER_CONCURRENCY=4
SIGNAL_QUEUE_LIMIT=20000
SIGNAL_MAX_ATTEMPTS=3
SIGNAL_RETRY_BASE_SECONDS=5
SIGNAL_CLAIM_TIMEOUT_SECONDS=600
